from collections import Counter

# ---------- Calculator ----------
def add(a, b): return a + b
def subtract(a, b): return a - b
def multiply(a, b): return a * b
def divide(a, b):
    if b == 0:
        return "Error: Division by zero"
    return a / b

def calculator():
    print("\n--- Calculator ---")
    print("1. Add  2. Subtract  3. Multiply  4. Divide")
    choice = input("Enter choice (1-4): ")

    if choice not in ("1", "2", "3", "4"):
        print("Invalid choice.")
        return

    try:
        a = float(input("Enter first number: "))
        b = float(input("Enter second number: "))
    except ValueError:
        print("Invalid input. Numbers only.")
        return

    operations = {"1": add, "2": subtract, "3": multiply, "4": divide}
    print("Result:", operations[choice](a, b))

# ---------- Repeat Value Finder ----------
def find_repeats():
    print("\n--- Repeat Value Finder ---")
    data = input("Enter values separated by spaces: ").split()

    counts = Counter(data)
    repeats = {v: c for v, c in counts.items() if c > 1}

    if repeats:
        for value, count in repeats.items():
            print(f"{value} repeats {count} times")
    else:
        print("No repeated values.")

# ---------- Main Menu ----------
def main():
    while True:
        print("\n===== MAIN MENU =====")
        print("1. Calculator")
        print("2. Find repeated values")
        print("3. Exit")

        choice = input("Enter choice (1-3): ")

        if choice == "1":
            calculator()
        elif choice == "2":
            find_repeats()
        elif choice == "3":
            print("Goodbye!")
            break
        else:
            print("Invalid choice. Try again.")

main()